# قالب .env للإنتاج على Hostinger (veonasa.com) — بلا أسرار، يُنسخ إلى .env على الخادم مرة واحدة.
# بعد النسخ: php artisan key:generate --force، ثم يكتب صاحب الحساب DB_PASSWORD بيده.
# مفاتيح النماذج لا توضع هنا: تُدخل من /settings/ai بعد منح الإدارة (php artisan platform:admin البريد).
# أي تعديل لاحق على .env يحتاج php artisan config:cache كي يُقرأ.

APP_NAME="Marketer Ai"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Riyadh
APP_URL=https://veonasa.com
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u260325039_marketer
DB_USERNAME=u260325039_marketer
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database

QUEUE_CONNECTION=database
# أطول من أطول مهلة مهمة (استيراد المنتجات 900 ث). عمّال الـ cron يبدؤون كل دقيقة فيتداخلون،
# ومع الافتراضي (90 ث) يلتقط عامل ثانٍ مهمة لا تزال تعمل: يُنفَّذ التوليد ويُدفع ثمنه مرتين.
DB_QUEUE_RETRY_AFTER=1000

FILESYSTEM_DISK=public
MEDIA_DISK=public

# لا fake في الإنتاج: بلا مفتاح يفشل التوليد بوضوح بدل «[نص تجريبي]» صامت يستهلك النقاط
AI_TEXT_PROVIDER=openrouter
AI_IMAGE_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=google/gemini-3.6-flash
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image
AI_PROOFREAD=true
AI_PROOFREAD_MODEL=
BRAND_PROFILE_POLISH=true
AI_REMOVE_BG_MODEL=openai/gpt-image-2.5-flare

MAIL_MAILER=log

SALLA_CLIENT_ID=
SALLA_CLIENT_SECRET=
SALLA_REDIRECT_URI="${APP_URL}/integrations/salla/callback"

META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI="${APP_URL}/integrations/meta/callback"

CREDITS_MONTHLY_ALLOWANCE=1000
CREDITS_DAILY_CAP=60
