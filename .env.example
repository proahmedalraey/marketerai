APP_NAME="Marketer Ai"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Riyadh
APP_URL=http://localhost:8000
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=marketer_ai
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database

QUEUE_CONNECTION=database
# للإنتاج: redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

FILESYSTEM_DISK=public
MEDIA_DISK=public
# للإنتاج: s3 أو r2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

# ============ طبقة الذكاء الاصطناعي ============
# fake = يعمل بلا مفاتيح، مفيد للتطوير والاختبار
AI_TEXT_PROVIDER=fake
AI_IMAGE_PROVIDER=fake

ANTHROPIC_API_KEY=
ANTHROPIC_TEXT_MODEL=claude-sonnet-4-5

OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1
OPENAI_IMAGE_MODEL=gpt-image-1

GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.6-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# نموذج خاص لتوليد ملف الهوية (فارغ = مزود النص الافتراضي)
# مثال: AI_PROFILE_PROVIDER=openai و AI_PROFILE_MODEL=gpt-4.1
AI_PROFILE_PROVIDER=
AI_PROFILE_MODEL=

# ============ التكاملات ============
SALLA_CLIENT_ID=
SALLA_CLIENT_SECRET=
SALLA_REDIRECT_URI="${APP_URL}/integrations/salla/callback"

META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI="${APP_URL}/integrations/meta/callback"

# ============ النقاط ============
CREDITS_MONTHLY_ALLOWANCE=1000
CREDITS_DAILY_CAP=60
